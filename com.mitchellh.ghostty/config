# Ghostty config
#
# macOS config path:
#   ~/Library/Application Support/com.mitchellh.ghostty/config
#
# Cross-platform/XDG path:
#   ~/.config/ghostty/config

# Theme
theme = Material Ocean

# Font
#
# Your WezTerm config used:
#   Source Code Pro for Powerline, Bold + Italic, size 11
#
# Ghostty does not have a single direct equivalent for “make all terminal text
# bold italic”. This sets the family and size, and lets apps request bold/italic
# normally.
font-family = "Source Code Pro for Powerline"
font-size = 12

# Bell
#
# Equivalent intent to:
#   config.audible_bell = "Disabled"
#
# Disables the macOS system alert sound.
bell-features = no-system

# Tabs / titlebar
#
# WezTerm:
#   config.enable_tab_bar = false
#
# On macOS, Ghostty's visible tab/titlebar behavior is mainly controlled by
# macos-titlebar-style. "transparent" is Ghostty's default and keeps the UI
# minimal without using the custom tabs titlebar.
#
# If you want the titlebar completely hidden, change this to:
#   macos-titlebar-style = hidden
macos-titlebar-style = transparent

# Keep Option behaving like terminal Alt.
#
# This is important for shell, tmux, and Neovim mappings.
macos-option-as-alt = true

# Keybindings
#
# WezTerm:
#   CMD+m -> DisableDefaultAssignment
#
# In Ghostty, "ignore" consumes the key and does nothing.
keybind = cmd+m=ignore

# WezTerm:
#   OPT+Enter -> DisableDefaultAssignment
keybind = alt+enter=ignore

# Neovim buffer/file switching
#
# This preserves your previous Ghostty behavior.
#
# It intentionally maps:
#   Ctrl+Tab       -> CSI 9;3u
#   Ctrl+ShiftTab  -> CSI 9;2u
#
# This matches the spirit of your WezTerm setup:
#   Ctrl+Tab       -> sends Opt/Alt+Tab
#   Ctrl+ShiftTab  -> sends Shift+Tab
#
# Keep the unbind lines so Ghostty's default bindings do not intercept these.
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=csi:9;3u
keybind = ctrl+shift+tab=csi:9;2u

# Word movement
#
# WezTerm:
#   OPT+LeftArrow  -> ALT+b
#   OPT+RightArrow -> ALT+f
#
# In terminal terms:
#   ALT+b == ESC b
#   ALT+f == ESC f
keybind = alt+left=esc:b
keybind = alt+right=esc:f
